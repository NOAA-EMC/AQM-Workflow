#!/bin/bash
#SBATCH -e %ECF_JOBOUT%
#SBATCH -o %ECF_JOBOUT%
#SBATCH --job-name="aqm_post_%FHR%_%CYC%"
#SBATCH --account=%PROJ%
#SBATCH --qos=%QUEUE%
#SBATCH --clusters=c6
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=24
#SBATCH --time=%WALLTIME:00:10:00%

model=aqm
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module use ${stack_location}
module load stack-intel/${stack_intel_ver}
module load craype/${craype_ver}
module load stack-cray-mpich/${cray_mpich_ver}
#module load cray-pals/${cray_pals_ver}
module load libjpeg/${libjpeg_ver}
module load hdf5/${hdf5_ver}
module load netcdf-c/${netcdf_ver}
module load netcdf-fortran/${netcdf_fortran_ver}
module load stack-python/${python_ver}
module load python/${python_ver}

module list

export fhr="%FHR%"

############################################################
# CALL executable job script here
############################################################
${HOMEaqm}/jobs/JAQM_POST

%include <tail.h>

%manual
%end
