#!/bin/bash
#SBATCH -e %ECF_JOBOUT%
#SBATCH -o %ECF_JOBOUT%
#SBATCH --job-name="aqm_nexus_emission_%NSPT%_%CYC%"
#SBATCH --account=%PROJ%
#SBATCH --qos=%QUEUE%
#SBATCH --clusters=c6
#SBATCH --partition=batch
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=96
#SBATCH --cpus-per-task=2
#SBATCH --time=%WALLTIME:00:25:00%

export OMP_NUM_THREADS=2
export OMP_STACKSIZE=1024M
export NC_BLKSZ=1M
export FI_VERBS_PREFER_XRC=0
export FI_CXI_RX_MATCH_MODE=hybrid

model=aqm
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module use ${stack_location}
module load stack-intel/${intel_ver}
module load prod_util/${prod_util_ver}
module load craype/${craype_ver}
module load stack-cray-mpich/${cray_mpich_ver}
module load libjpeg/${libjpeg_ver}
module load hdf5/${hdf5_ver}
module load netcdf-c/${netcdf_ver}
module load netcdf-fortran/${netcdf_fortran_ver}
module load stack-python/${python_ver}
module load python/${python_ver}
module load py-jinja2
module load py-netcdf4
module load py-scipy
module load py-numpy

module list

export nspt="%NSPT%"

############################################################
# CALL executable job script here
############################################################
${HOMEaqm}/jobs/JAQM_NEXUS_EMISSION

%include <tail.h>

%manual
%end
