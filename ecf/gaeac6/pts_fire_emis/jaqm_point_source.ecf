#!/bin/bash
#SBATCH -e %ECF_JOBOUT%
#SBATCH -o %ECF_JOBOUT%
#SBATCH --job-name="aqm_point_source_%CYC%"
#SBATCH --account=%PROJ%
#SBATCH --qos=%QUEUE%
#SBATCH --clusters=c6
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --time=%WALLTIME:00:15:00%

model=aqm
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#module load cray-pals/${cray_pals_ver}
module use ${stack_location}
module load stack-intel/${intel_ver}
module load craype/${craype_ver}
module load stack-cray-mpich/${cray_mpich_ver}
module load netcdf-c/${netcdf_ver}
module load netcdf-fortran/${netcdf_fortran_ver}
module load prod_util/${prod_util_ver}
module load stack-python/${python_ver}
module load python/${python_ver}
module load py-xarray
module load py-jinja2
module load py-netcdf4

module list

############################################################
# CALL executable job script here
############################################################
${HOMEaqm}/jobs/JAQM_POINT_SOURCE

%include <tail.h>

%manual
%end
